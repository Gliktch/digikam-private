#: core/libs/dimg/filters/nr/nrfilter.cpp:127
#, kde-format
msgid "Noise Reduction Filter"
msgstr "Filter redukcie šumu"

#: core/libs/dimg/filters/nr/nrsettings.cpp:85
#, kde-format
msgid ""
"<b>Threshold</b>: Adjusts the threshold for denoising of the image in a "
"range from 0.0 (none) to 10.0. The threshold is the value below which "
"everything is considered noise."
msgstr ""
"<b>Prah</b>:Prispôsobí prah pre odstránenie šumu z obrázka v rozmedzí od 0.0 "
"(žiadny) do 10.0. Prah je hodnota, ktorá určuje čo všetko je považované za "
"šum."

#: core/libs/dimg/filters/nr/nrsettings.cpp:89
#, kde-format
msgid ""
"<b>Softness</b>: This adjusts the softness of the thresholding (soft as "
"opposed to hard thresholding). The higher the softness the more noise "
"remains in the image."
msgstr ""
"<b>Jemnosť</b>: Upravuje jemnosť prahu (jeho protiklad je hrubý prah). "
"Väčšia jemnost znamená, že v obrázku zostane viac šumu."

#: core/libs/dimg/filters/nr/nrsettings.cpp:95
#, kde-format
msgid "Estimate Noise"
msgstr "Odhadnúť šum"

#: core/libs/dimg/filters/nr/nrsettings.cpp:96
#, kde-format
msgid ""
"Compute automatically all noise reduction settings by a parse of noise "
"contained in image."
msgstr ""
"Urobí rozbor šumu v obrázku a automaticky vypočíta nastavenia pre "
"odstránenie šumu."


#: core/dplugins/editor/colors/film/filmtool.cpp:220
#, kde-format
msgid "Adjust white point automatically."
msgstr "Nastaviť biely bod automaticky."

#: core/dplugins/editor/colors/film/filmtool.cpp:221
#, kde-format
msgid ""
"If you press this button, the white point is calculated from the image data "
"automatically. This function requires to have some residual orange mask "
"around the exposed area of the negative."
msgstr ""
"Stlačením tohto tlačidla bude biely bod vypočítaný automaticky z údajov "

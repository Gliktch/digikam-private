#, kde-format
msgid "\"%1\" is not a Photograph Refocus settings text file."
msgstr "„%1“ nie je textový súbor s nastavením Zaostrovania fotografie."

#: core/libs/dimg/filters/sharp/sharpsettings.cpp:529
#, kde-format
msgid "Cannot load settings from the Photograph Refocus text file."
msgstr ""
"Nie je možné načítať nastavenia z textového súboru Zaostrenie fotografie"

#: core/libs/dimg/filters/sharp/sharpsettings.cpp:537
#, kde-format
msgctxt "@title:window"
msgid "Photograph Refocus Settings File to Save"
msgstr "Súbor nastavení Zaostrenia fotografie na uloženie"

#: core/libs/dimg/filters/sharp/sharpsettings.cpp:567
#, kde-format
msgid "Cannot save settings to the Photograph Refocus text file."
msgstr ""

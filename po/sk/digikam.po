#: core/dplugins/generic/view/glviewer/glviewerplugin.cpp:61
#, kde-format
msgid ""
"<p>This tool preview a series of items using OpenGL effects.</p><p><u>Usage:"
"</u></p><table><tr><td colspan=\"2\"><nobr><center><b><h1>Item Access</h1></"
"b></center></nobr></td></tr><tr><td>Previous Item:</td><td><i>Up</i> key</"
"td></tr><tr><td></td><td><i>PgUp</i> key</td></tr><tr><td></td><td><i>Left</"
"i> key</td></tr><tr><td></td><td>Mouse wheel up</td></tr><tr><td>Next Item:</"
"td><td><i>Down</i> key</td></tr><tr><td></td><td><i>PgDown</i> key</td></"
"tr><tr><td></td><td><i>Right</i> key</td></tr><tr><td></td><td>Mouse wheel "
"down</td></tr><tr><td>Quit:</td><td><i>Esc</i> key</td></tr><tr><td colspan="
"\"2\"><nobr><center><b><h1>Item Display</h1></b></center></nobr></td></"
"tr><tr><td>Toggle fullscreen to normal:</td><td><i>f</i> key</td></"
"tr><tr><td>Toggle scroll-wheel action:</td><td><i>c</i> key (either zoom or "
"change item)</td></tr><tr><td>Rotation:</td><td><i>r</i> key</td></"
"tr><tr><td>Reset view:</td><td>double click</td></tr><tr><td>Original size:</"
"td><td><i>o</i> key</td></tr><tr><td>Zooming:</td><td>Move mouse in up-down-"
"direction while pressing the right mouse button</td></tr><tr><td></"
"td><td><i>c</i> key and use the scroll-wheel</td></tr><tr><td></td><td><i>+</"
"i> and <i>-</i> keys</td></tr><tr><td></td><td>ctrl + scrollwheel</td></"
"tr><tr><td>Panning:</td><td>Move mouse while pressing the left button</td></"
"tr><tr><td colspan=\"2\"><nobr><center><b><h1>Others</h1></b></center></"
"nobr></td></tr><tr><td>Show this help:</td><td><i>F1</i> key</td></tr></"
"table>"
msgstr ""
"<p>Tento nástroj zobrazuje náhľad série položiek pomocou efektov OpenGL.</"
"p><p><u>Používanie:</u></p><table><tr><td colspan="
"\"2\"><nobr><center><b><h1>Prístup k položkám</h1></b></center></nobr></td></"
"tr><tr><td>Predchádzajúca položka:</td><td>kláves <i>Hore</i></td></"
"tr><tr><td></td><td>kláves <i>PgUp</i></td></tr><tr><td></td><td>kláves "
"<i>Vľavo</i></td></tr><tr><td></td><td>Koliesko myši hore</td></"
"tr><tr><td>Nasledujúca položka:</td><td>kláves <i>Dole</i></td></"
"tr><tr><td></td><td>kláves <i>PgDown</i></td></tr><tr><td></td><td>kláves "
"<i>Vpravo</i></td></tr><tr><td></td><td>Koliesko myši dole</td></"
"tr><tr><td>Ukončiť:</td><td>kláves <i>Esc</i></td></tr><tr><td colspan="
"\"2\"><nobr><center><b><h1>Zobrazenie položky</h1></b></center></nobr></td></"
"tr><tr><td>Prepnúť celú obrazovku na normálnu:</td><td>kláves <i>f</i></td></"
"tr><tr><td>Prepnúť akciu kolieska:</td><td>kláves <i>c</i> (priblíženie "
"alebo zmena položky)</td></tr><tr><td>Otočenie:</td><td>kláves <i>r</i></"
"td></tr><tr><td>Resetovať zobrazenie:</td><td>dvojklik</td></"
"tr><tr><td>Pôvodná veľkosť:</td><td>kláves <i>o</i></td></"
"tr><tr><td>Priblíženie:</td><td>Pohyb myši hore-dole pri stlačenom pravom "
"tlačidle myši</td></tr><tr><td></td><td>kláves <i>c</i> a použitie kolieska</"
"td></tr><tr><td></td><td>klávesy <i>+</i> a <i>-</i></td></tr><tr><td></"
"td><td>ctrl + koliesko myši</td></tr><tr><td>Posúvanie:</td><td>Pohyb myši "
"pri stlačenom ľavom tlačidle</td></tr><tr><td colspan="
"\"2\"><nobr><center><b><h1>Ostatné</h1></b></center></nobr></td></"
"tr><tr><td>Zobraziť túto pomoc:</td><td>kláves <i>F1</i></td></tr></table>"


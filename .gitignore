# Ignore external repository dirs
doc
test-data
local-docs/

# Keep local planning records out of the publishable source repository.
/*.md
!/README.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md

# Ignore unit-test files
Testing/

# Ignore local swap
*.kate-swp
*.swp

# Ignore local config
.vscode
.kateconfig
*.autosave
*.config
*.creator
*.creator.user
*.files
*.includes
.kdev_include_paths
*.kde4
*.kdev4
.idea
.venv

# Ignore local cache
__pycache__
.DS_Store
.directory
.gdb_history
*.egg-info

# Ignore build files
build*
qtcreator-build
build_dir
.flatpak-builder
compile_commands.json
temp.*/

# Ignore temporary files
*.orig
*.rej
*.trace
CMakeLists.txt.user*
*~
GTAGS
GPATH
GRTAGS
GSYMS
BROWSE
